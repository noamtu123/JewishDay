# Formatting the code follows, read by Android Studio / IntelliJ and any editor with EditorConfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Lines read best under ~120; a few long `when` branches and test tables run past it on purpose.
max_line_length = 150
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
# One sorted block, no wildcards, no blank lines between groups.
ij_kotlin_imports_layout = *
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.md]
trim_trailing_whitespace = false
