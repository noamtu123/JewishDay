    <string name="about_tagline">Hebrew dates, zmanim, and daily learning — in one quiet, private app.</string>
    <string name="about_tagline_hebrew">תאריך עברי, זמנים ולימוד יומי — באפליקציה אחת, שקטה ופרטית.</string>
    <string name="about_feature_dates">Hebrew date, parsha, Yom Tov, fast days, Omer, and Rosh Chodesh at a glance.</string>
    <string name="about_feature_dates_hebrew">תאריך עברי, פרשת השבוע, יום טוב, תעניות, ספירת העומר וראש חודש במבט מהיר.</string>
    <string name="about_feature_zmanim">Location-based zmanim you can tune, with a detailed calculation method for every time.</string>
    <string name="about_feature_zmanim_hebrew">זמנים לפי המיקום שלך שניתן לכוונן, עם שיטת חישוב מפורטת לכל זמן.</string>
    <string name="about_feature_tools">Daily learning, a prayer-direction compass, and an optional Hebrew-date notification.</string>
    <string name="about_feature_tools_hebrew">לימוד יומי, מצפן לכיוון התפילה, והתראת תאריך עברי לבחירתך.</string>
    <string name="about_values_heading">Free, open, and yours</string>
    <string name="about_values_heading_hebrew">חופשי, פתוח, ושלך</string>
    <string name="about_values_body">JewishDay is free and open source — no ads, no tracking, no accounts. Nothing about your day leaves your phone. The full source is on GitHub for anyone to read, check, or build on. It is simply the kind of app I wish every app was, so I built it that way.</string>
    <string name="about_values_body_hebrew">JewishDay היא חופשית וקוד פתוח — בלי פרסומות, בלי מעקב ובלי חשבונות. שום דבר מהיום שלך לא יוצא מהטלפון. כל קוד המקור נמצא ב‑GitHub, פתוח לכל אחד לקרוא, לבדוק או לבנות עליו. זו פשוט האפליקציה שהייתי רוצה שכל אפליקציה תהיה, אז בניתי אותה כך.</string>
