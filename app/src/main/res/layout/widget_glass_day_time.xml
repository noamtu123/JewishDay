<?xml version="1.0" encoding="utf-8"?>
<!-- One column of the day widget's times row: the label over its clock time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/day_time_label"
        style="@style/Widget.JewishDay.Glass.Text"
        android:layout_width="match_parent"
        android:maxLines="2" />

    <TextView
        android:id="@+id/day_time_value"
        style="@style/Widget.JewishDay.Glass.Text.Time"
        android:layout_width="match_parent" />
</LinearLayout>
