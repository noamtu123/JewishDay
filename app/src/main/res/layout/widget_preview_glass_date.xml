<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows on Android 12-14: the layout with sample content, by day.
     Android 15+ shows the widget itself instead (WidgetUpdater.publishPreviews). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layoutDirection="rtl"
    style="@style/Widget.JewishDay.Glass.Root">

    <ImageView
        style="@style/Widget.JewishDay.Glass.Sky"
        android:contentDescription="@null"
        android:src="@drawable/widget_glass_preview_sky" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:text="@string/widget_preview_hebrew_date"
            style="@style/Widget.JewishDay.GlassDay.Text.Title"
            android:textSize="28sp" />

        <TextView
            android:text="@string/widget_preview_gregorian_date"
            style="@style/Widget.JewishDay.GlassDay.Text.Label"
            android:textSize="13sp" />

        <TextView
            android:text="@string/widget_preview_special_day"
            style="@style/Widget.JewishDay.GlassDay.Text.Chip" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            style="@style/Widget.JewishDay.GlassDay.Pane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="@string/widget_preview_next_label"
                    style="@style/Widget.JewishDay.GlassDay.Text.Label" />

                <TextView
                    android:text="@string/widget_preview_next_title"
                    style="@style/Widget.JewishDay.GlassDay.Text.Strong" />
            </LinearLayout>

            <TextView
                android:text="@string/widget_preview_next_time"
                style="@style/Widget.JewishDay.GlassDay.Text.Time"
                android:layout_marginStart="8dp"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
