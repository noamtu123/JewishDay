<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): the layout with sample content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layoutDirection="rtl"
    style="@style/Widget.JewishDay.Glass.Root">

    <ImageView
        style="@style/Widget.JewishDay.Glass.Sky"
        android:contentDescription="@null"
        android:src="@drawable/widget_glass_preview_sky" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:text="@string/widget_preview_parsha"
            style="@style/Widget.JewishDay.Glass.Text.Title"
            android:textSize="20sp" />

        <TextView
            style="@style/Widget.JewishDay.Glass.Text.Chip" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Widget.JewishDay.Glass.Pane"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="@string/widget_preview_entry_label"
                    style="@style/Widget.JewishDay.Glass.Text.Label" />

                <TextView
                    android:text="@string/widget_preview_entry_time"
                    style="@style/Widget.JewishDay.Glass.Text.Time"
                    android:textSize="22sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <LinearLayout
                style="@style/Widget.JewishDay.Glass.Pane"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="@string/widget_preview_exit_label"
                    style="@style/Widget.JewishDay.Glass.Text.Label" />

                <TextView
                    android:text="@string/widget_preview_exit_time"
                    style="@style/Widget.JewishDay.Glass.Text.Time"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
