<?xml version="1.0" encoding="utf-8"?>
<!-- GlassWidgetRenderer.kt counts rows from these sizes (GlassZmanimChromeDp, ZmanimRowDp): keep them in step. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.JewishDay.Glass.Root">

    <ImageView
        android:id="@+id/glass_sky"
        style="@style/Widget.JewishDay.Glass.Sky"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/glass_hebrew_date"
                style="@style/Widget.JewishDay.Glass.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/glass_special_day"
                style="@style/Widget.JewishDay.Glass.Text.Chip"
                android:layout_marginStart="8dp"
                android:layout_marginTop="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glass_pane"
            style="@style/Widget.JewishDay.Glass.Pane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/glass_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
