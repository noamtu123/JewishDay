<?xml version="1.0" encoding="utf-8"?>
<!-- One row high (2x1 and up): the next time on the sky at the start, its sun or moon at the end. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.JewishDay.Glass.Root">

    <ImageView
        android:id="@+id/glass_sky"
        style="@style/Widget.JewishDay.Glass.Sky"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/glass_next_title"
            style="@style/Widget.JewishDay.Glass.Text.Strong"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/glass_next_time"
            style="@style/Widget.JewishDay.Glass.Text.Time"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/glass_following"
            style="@style/Widget.JewishDay.Glass.Text.Label"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
