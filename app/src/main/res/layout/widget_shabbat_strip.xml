<?xml version="1.0" encoding="utf-8"?>
<!-- One row high (3x1, the default): the parsha or chag at the start, its two times at the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.JewishDay.Root"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_shabbat_heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_shabbat_title"
            style="@style/Widget.JewishDay.Text.Title"
            android:maxLines="2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_shabbat_subtitle"
            style="@style/Widget.JewishDay.Text.Accent"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_entry_label"
            style="@style/Widget.JewishDay.Text.Secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_entry_time"
            style="@style/Widget.JewishDay.Text.RowTime"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_exit_label"
            style="@style/Widget.JewishDay.Text.Secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_exit_time"
            style="@style/Widget.JewishDay.Text.RowTime"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
