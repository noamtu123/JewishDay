<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.JewishDay.Root"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_shabbat_title"
        style="@style/Widget.JewishDay.Text.Title"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_shabbat_subtitle"
        style="@style/Widget.JewishDay.Text.Accent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_entry_label"
            style="@style/Widget.JewishDay.Text.Row"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_entry_time"
            style="@style/Widget.JewishDay.Text.RowTime"
            android:layout_marginStart="8dp"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_exit_label"
            style="@style/Widget.JewishDay.Text.Row"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_exit_time"
            style="@style/Widget.JewishDay.Text.RowTime"
            android:layout_marginStart="8dp"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
