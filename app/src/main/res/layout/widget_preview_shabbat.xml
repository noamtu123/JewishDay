<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows on Android 12-14: the 3x1 layout with sample content, by day.
     Android 15+ shows the widget itself instead (WidgetUpdater.publishPreviews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layoutDirection="rtl"
    style="@style/Widget.JewishDay.Root"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:text="@string/widget_preview_parsha"
            style="@style/Widget.JewishDay.Text.Title"
            android:maxLines="2"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:text="@string/widget_preview_entry_label"
            style="@style/Widget.JewishDay.Text.Secondary"
            android:textSize="11sp" />

        <TextView
            android:text="@string/widget_preview_entry_time"
            style="@style/Widget.JewishDay.Text.RowTime"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:text="@string/widget_preview_exit_label"
            style="@style/Widget.JewishDay.Text.Secondary"
            android:textSize="11sp" />

        <TextView
            android:text="@string/widget_preview_exit_time"
            style="@style/Widget.JewishDay.Text.RowTime"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
