<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.JewishDay.Glass.Root">

    <ImageView
        android:id="@+id/glass_sky"
        style="@style/Widget.JewishDay.Glass.Sky"
        android:contentDescription="@null" />

    <!-- The pane sits low, leaving the top of the widget to the sky and its sun or moon: the zman
         beside its time, and the one after it across the bottom. -->
    <LinearLayout
        android:id="@+id/glass_pane"
        style="@style/Widget.JewishDay.Glass.Pane"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/glass_next_label"
                    style="@style/Widget.JewishDay.Glass.Text.Label" />

                <TextView
                    android:id="@+id/glass_next_title"
                    style="@style/Widget.JewishDay.Glass.Text.Strong"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/glass_next_time"
                style="@style/Widget.JewishDay.Glass.Text.Time"
                android:layout_marginStart="8dp"
                android:textSize="30sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/glass_following"
            style="@style/Widget.JewishDay.Glass.Text.Label"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
