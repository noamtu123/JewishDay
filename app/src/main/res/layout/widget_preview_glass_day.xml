<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): the layout with sample content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layoutDirection="rtl"
    style="@style/Widget.JewishDay.Glass.Root">

    <ImageView
        style="@style/Widget.JewishDay.Glass.Sky"
        android:contentDescription="@null"
        android:src="@drawable/widget_glass_preview_sky" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:text="@string/widget_preview_hebrew_date"
            style="@style/Widget.JewishDay.Glass.Text.Title"
            android:layout_width="match_parent"
            android:textSize="28sp" />

        <TextView
            android:text="@string/widget_preview_gregorian_date"
            style="@style/Widget.JewishDay.Glass.Text"
            android:layout_width="match_parent"
            android:textColor="#FFCDD2EC" />

        <LinearLayout
            style="@style/Widget.JewishDay.Glass.Pane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingTop="4dp"
            android:paddingEnd="0dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:text="@string/widget_preview_plag"
                    style="@style/Widget.JewishDay.Glass.Text.Label"
                    android:layout_width="match_parent" />

                <TextView
                    android:text="@string/widget_preview_plag_time"
                    style="@style/Widget.JewishDay.Glass.Text.Time"
                    android:layout_width="match_parent"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:text="@string/widget_preview_next_title"
                    style="@style/Widget.JewishDay.Glass.Text.Label"
                    android:layout_width="match_parent" />

                <TextView
                    android:text="@string/widget_preview_next_time"
                    style="@style/Widget.JewishDay.Glass.Text.Time"
                    android:layout_width="match_parent"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:text="@string/widget_preview_tzeit"
                    style="@style/Widget.JewishDay.Glass.Text.Label"
                    android:layout_width="match_parent" />

                <TextView
                    android:text="@string/widget_preview_tzeit_time"
                    style="@style/Widget.JewishDay.Glass.Text.Time"
                    android:layout_width="match_parent"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
