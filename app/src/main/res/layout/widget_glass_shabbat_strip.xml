<?xml version="1.0" encoding="utf-8"?>
<!-- One row high: what is coming at the start, its two times in small panes at the end. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.JewishDay.Glass.Root">

    <ImageView
        android:id="@+id/glass_sky"
        style="@style/Widget.JewishDay.Glass.Sky"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/glass_shabbat_title"
                style="@style/Widget.JewishDay.Glass.Text.Title"
                android:maxLines="2"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/glass_shabbat_subtitle"
                style="@style/Widget.JewishDay.Glass.Text.Label"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glass_entry_pane"
            style="@style/Widget.JewishDay.Glass.Pane"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/glass_entry_label"
                style="@style/Widget.JewishDay.Glass.Text.Label"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/glass_entry_time"
                style="@style/Widget.JewishDay.Glass.Text.Time"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glass_exit_pane"
            style="@style/Widget.JewishDay.Glass.Pane"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/glass_exit_label"
                style="@style/Widget.JewishDay.Glass.Text.Label"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/glass_exit_time"
                style="@style/Widget.JewishDay.Glass.Text.Time"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
