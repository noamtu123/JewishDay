<?xml version="1.0" encoding="utf-8"?>
<!-- Refreshed by WidgetUpdater at each change and as the sky moves; the periodic update is only a safety net.
     Resizes down to a strip: the widget fits what it shows to whatever frame it is given. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_glass_day_description"
    android:initialLayout="@layout/widget_glass_day"
    android:previewLayout="@layout/widget_preview_glass_day"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="10800000"
    android:widgetCategory="home_screen" />
